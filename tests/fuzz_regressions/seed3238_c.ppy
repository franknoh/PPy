class Counter:
    def __init__(self, start: int) -> None:
        self.count: int = start

    def bump(self, by: int) -> int:
        self.count += by
        return self.count


def biggest[T: int | float](values: Vec[T]) -> T:
    best = values[0]
    for value in values:
        if value > best:
            best = value
    return best


