# fuzz: path=standalone seed=112 (float != and truth were ordered: false for NaN; a NaN divisor raised ZeroDivisionError)
def truthy(x: float) -> bool:
    if x:
        return True
    return False


def divide(x: float, y: float) -> float:
    return x / y


def main() -> None:
    nan = float("nan")
    print(truthy(nan), truthy(0.0), divide(1.0, nan), divide(nan, 2.0))


main()
