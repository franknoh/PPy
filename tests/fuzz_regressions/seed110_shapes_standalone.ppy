    for _ in range(n % 4):
        a, b = b, a
    return sum(counts) + sum(seen) + a[0] * 10 + len(b)


def sh93(k: int, *xs: int) -> int:
    t = 0
    for x in xs:
        t += x * k
    return t + len(xs)


def sh94(n: int) -> int:
    return sh93(n) + sh93(n, n + 1) + sh93(2, n, -n, -5)


