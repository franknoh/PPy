def sh89(n: int) -> int:
    if n > -1:
        return n * 5
    elif n < -2:
        raise ValueError("below")
    else:
        return 5


def sh90(xs: list[int], k: int) -> list[int]:
    if not xs:
        return xs
    if xs == []:
        return [k]
    if len(xs) == 3:
        a, b, c = xs
        return [c, b, a + k]
    return xs[0 : len(xs) - 1]


def sh91(text: str, key: int) -> str:
    out = ''
    for ch in text:
        found = SHAPE_WORD.find(ch.upper())
        out += ch if found == -1 else SHAPE_WORD[(found + key) % len(SHAPE_WORD)]
    return out + SHAPE_WORD[:4]


def sh92(n: int) -> int:
