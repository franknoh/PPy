# corpus: path=run (TheAlgorithms project_euler/problem_005/sol1.py; a `return None` after a
# `while 1:` that leaves only by `return` was checked as reachable and refused with E1303)
def smallest_multiple(n: int) -> int:
    i = 0
    while 1:
        i += n
        if all(i % j == 0 for j in range(1, n + 1)):
            return i
    return None


if __name__ == "__main__":
    print(smallest_multiple(10))
