def sh57(n: int) -> int:
    if n > -2:
        return n * 1
    elif n < -3:
        return -n - 0
    else:
        return 0


def sh58(xs: list[int], k: int) -> list[int]:
    if not xs:
        return xs
    if xs == []:
        return [k]
    if len(xs) == 3:
        a, b, c = xs
        return [c, b, a + k]
    return xs[2 : len(xs) - 0]


def sh59(text: str, key: int) -> str:
    out = ''
    for ch in text:
        found = SHAPE_WORD.find(ch.upper())
        out += ch if found == -1 else SHAPE_WORD[(found + key) % len(SHAPE_WORD)]
    return out + SHAPE_WORD[:4]


def sh60(n: int) -> int:
    counts, seen = [0] * (n % 5 + 1), [6] * 2
    a = [1, 2]
    b = [3]
    for _ in range(n % 4):
        a, b = b, a
    return sum(counts) + sum(seen) + a[0] * 10 + len(b)


def sh61(k: int, *xs: int) -> int:
    t = 0
    for x in xs:
        t += x * k
    return t + len(xs)


def sh62(n: int) -> int:
    return sh61(n) + sh61(n, n + 1) + sh61(2, n, -n, 4)


