"""Substring search with the Knuth-Morris-Pratt failure table.

Input:  the text T on the first line, the pattern P on the second.
Output: how many times P occurs in T.
"""

import array

import ppy
from ppy import Buffer


@ppy.opt(3)
def build_failure(pattern: Buffer[ppy.i8], failure: Buffer[int]) -> int:
    failure[0] = 0
    length: int = 0
    for i in range(1, len(pattern)):
        while length > 0 and pattern[i] != pattern[length]:
            length = failure[length - 1]
        if pattern[i] == pattern[length]:
            length += 1
        failure[i] = length
    return length


@ppy.opt(3)
def count_matches(text: Buffer[ppy.i8], pattern: Buffer[ppy.i8], failure: Buffer[int]) -> int:
    found: int = 0
    length: int = 0
    for i in range(len(text)):
        while length > 0 and text[i] != pattern[length]:
            length = failure[length - 1]
        if text[i] == pattern[length]:
            length += 1
        if length == len(pattern):
            found += 1
            length = failure[length - 1]
    return found


def read_case() -> tuple[Buffer[ppy.i8], Buffer[ppy.i8]]:
    """The judge's two tokens, or a stand-in when nothing is piped in.

    The characters land in a byte buffer directly: `Buffer[ppy.i8]` is one
    byte per element, so four million characters cost four megabytes rather
    than the thirty-two a 64-bit element would.
    """
    haystack = array.array("b", bytes(4000064))
    size = ppy.read_token(haystack)
    if size == 0:
        for i in range(4000000):
            haystack[i] = 97 + (i * 7919) % 4
        size = 4000000
        needle = array.array("b", haystack[:12])
        return memoryview(haystack)[:size], memoryview(needle)
    needle = array.array("b", bytes(4096))
    length = ppy.read_token(needle)
    return memoryview(haystack)[:size], memoryview(needle)[:length]


def main() -> None:
    text, pattern = read_case()
    failure = array.array("q", [0] * len(pattern))
    build_failure(pattern, failure)
    print(count_matches(text, pattern, failure))


main()
