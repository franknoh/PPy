"""Range sums with point updates, judge style (Baekjoon 2042).

Input:  N M K on the first line, then N numbers, then M+K command lines --
        `1 b c` assigns c to position b, `2 b c` asks for the sum over
        [b, c).
Output: the checksum of every answered query, so one line stands in for K.
"""

import array
import time

import ppy
from ppy import Buffer


@ppy.opt(3)
def build(tree: Buffer[int], size: int) -> int:
    for i in range(size - 1, 0, -1):
        tree[i] = tree[2 * i] + tree[2 * i + 1]
    return tree[1]


@ppy.opt(3)
def update(tree: Buffer[int], size: int, position: int, value: int) -> int:
    index: int = position + size
    tree[index] = value
    index //= 2
    while index >= 1:
        tree[index] = tree[2 * index] + tree[2 * index + 1]
        index //= 2
    return tree[1]


@ppy.pure
@ppy.opt(3)
def query(tree: Buffer[int], size: int, left: int, right: int) -> int:
    total: int = 0
    low: int = left + size
    high: int = right + size
    while low < high:
        if low % 2 == 1:
            total += tree[low]
            low += 1
        if high % 2 == 1:
            high -= 1
            total += tree[high]
        low //= 2
        high //= 2
    return total


@ppy.opt(3)
def workload(tree: Buffer[int], size: int, rounds: int) -> int:
    checksum: int = 0
    for step in range(rounds):
        position: int = (step * 7919) % size
        update(tree, size, position, (step * 31) % 1000)
        left: int = (step * 104729) % size
        right: int = min(left + (step % 512) + 1, size)
        checksum += query(tree, size, left, right)
    return checksum


def generated() -> list[int]:
    """The stand-in input, in the same order the judge would send it."""
    size = 1 << 18
    rounds = 200000
    fields = [size, rounds, rounds]
    fields.extend((i * 7919) % 1000 for i in range(size))
    for step in range(rounds):
        fields.append(1)
        fields.append((step * 7919) % size)
        fields.append((step * 31) % 1000)
        left = (step * 104729) % size
        fields.append(2)
        fields.append(left)
        fields.append(min(left + (step % 512) + 1, size))
    return fields


def read_fields() -> Buffer[int]:
    """The judge's input, or a generated stand-in when nothing is piped in."""
    try:
        size, rounds, queries = ppy.input[tuple[int, int, int]]()
    except EOFError:
        return array.array("q", generated())
    fields = array.array("q", [size, rounds, queries])
    fields.extend(ppy.input[Buffer[int]](size + rounds * 6))
    return fields


@ppy.opt(3)
def run_commands(tree: Buffer[int], commands: Buffer[int], size: int, rounds: int) -> int:
    checksum: int = 0
    for step in range(rounds):
        base: int = step * 6
        update(tree, size, commands[base + 1], commands[base + 2])
        checksum += query(tree, size, commands[base + 4], commands[base + 5])
    return checksum


def main() -> None:
    started = time.perf_counter()
    fields = read_fields()
    read_ms = (time.perf_counter() - started) * 1000.0

    size = fields[0]
    rounds = fields[1]
    tree = array.array("q", [0] * (2 * size))
    for i in range(size):
        tree[size + i] = fields[3 + i]
    commands = array.array("q", fields[3 + size :])

    started = time.perf_counter()
    build(tree, size)
    checksum: int = run_commands(tree, commands, size, rounds)
    solve_ms = (time.perf_counter() - started) * 1000.0

    print(checksum)
    print(f"# n={size} q={rounds} read {read_ms:.1f} ms   solve {solve_ms:.1f} ms")


main()
