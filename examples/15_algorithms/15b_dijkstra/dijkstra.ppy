import array
import time
from typing import Final

import ppy
from ppy import Buffer

INFINITY: Final[int] = 1 << 60


@ppy.opt(3)
def sift_down(keys: Buffer[int], nodes: Buffer[int], size: int, start: int) -> int:
    position: int = start
    while True:
        left: int = 2 * position + 1
        if left >= size:
            break
        best: int = left
        right: int = left + 1
        if right < size and keys[right] < keys[left]:
            best = right
        if keys[position] <= keys[best]:
            break
        key: int = keys[position]
        node: int = nodes[position]
        keys[position] = keys[best]
        nodes[position] = nodes[best]
        keys[best] = key
        nodes[best] = node
        position = best
    return position


@ppy.opt(3)
def sift_up(keys: Buffer[int], nodes: Buffer[int], start: int) -> int:
    position: int = start
    while position > 0:
        parent: int = (position - 1) // 2
        if keys[parent] <= keys[position]:
            break
        key: int = keys[position]
        node: int = nodes[position]
        keys[position] = keys[parent]
        nodes[position] = nodes[parent]
        keys[parent] = key
        nodes[parent] = node
        position = parent
    return position


@ppy.opt(3)
def dijkstra(
    offsets: Buffer[int],
    targets: Buffer[int],
    weights: Buffer[int],
    distance: Buffer[int],
    keys: Buffer[int],
    nodes: Buffer[int],
    count: int,
) -> int:
    for i in range(count):
        distance[i] = INFINITY
    distance[0] = 0
    keys[0] = 0
    nodes[0] = 0
    size: int = 1
    while size > 0:
        best: int = keys[0]
        node: int = nodes[0]
        size -= 1
        keys[0] = keys[size]
        nodes[0] = nodes[size]
        sift_down(keys, nodes, size, 0)
        if best <= distance[node]:
            for edge in range(offsets[node], offsets[node + 1]):
                neighbour: int = targets[edge]
                relaxed: int = best + weights[edge]
                if relaxed < distance[neighbour]:
                    distance[neighbour] = relaxed
                    keys[size] = relaxed
                    nodes[size] = neighbour
                    size += 1
                    sift_up(keys, nodes, size - 1)
    total: int = 0
    for i in range(count):
        if distance[i] < INFINITY:
            total += distance[i]
    return total


def main() -> None:
    count: int = 200000
    degree: int = 6
    offsets = array.array("q", [i * degree for i in range(count + 1)])
    targets = array.array("q", [0] * (count * degree))
    weights = array.array("q", [0] * (count * degree))
    for i in range(count):
        for k in range(degree):
            edge: int = i * degree + k
            targets[edge] = (i * 7919 + k * 104729 + 1) % count
            weights[edge] = (i * 31 + k * 17) % 1000 + 1

    distance = array.array("q", [0] * count)
    keys = array.array("q", [0] * (count * degree + 1))
    nodes = array.array("q", [0] * (count * degree + 1))
    start = time.perf_counter()
    total: int = dijkstra(offsets, targets, weights, distance, keys, nodes, count)
    print(f"dijkstra 2e5{(time.perf_counter() - start) * 1000.0:12.1f} ms   -> {total}")


main()
