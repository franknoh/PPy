"""LIS with no interpreter under it."""

import ppy
from ppy import Buffer


def longest_increasing(values: Buffer[int], tails: Buffer[int]) -> int:
    length: int = 0
    for i in range(len(values)):
        value: int = values[i]
        low: int = 0
        high: int = length
        while low < high:
            middle: int = (low + high) // 2
            if tails[middle] < value:
                low = middle + 1
            else:
                high = middle
        tails[low] = value
        if low == length:
            length += 1
    return length


def main() -> None:
    count: int = ppy.input[int]()
    values: Buffer[int] = ppy.input[Buffer[int]](count)
    tails: Buffer[int] = ppy.buffer[int](count)
    print(longest_increasing(values, tails))


main()
