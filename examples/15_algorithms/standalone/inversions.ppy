"""Counting inversions with no interpreter under it."""

import ppy
from ppy import Buffer

LIMIT: int = 1000004


@ppy.opt(3)
def add(tree: Buffer[int], position: int, delta: int) -> int:
    index: int = position + 1
    while index < LIMIT:
        tree[index] += delta
        index += index & -index
    return index


@ppy.pure
@ppy.opt(3)
def prefix(tree: Buffer[int], position: int) -> int:
    total: int = 0
    index: int = position + 1
    while index > 0:
        total += tree[index]
        index -= index & -index
    return total


@ppy.opt(3)
def count_inversions(values: Buffer[int], tree: Buffer[int]) -> int:
    total: int = 0
    for i in range(len(values) - 1, -1, -1):
        total += prefix(tree, values[i] - 1)
        add(tree, values[i], 1)
    return total


def main() -> None:
    count: int = ppy.input[int]()
    values: Buffer[int] = ppy.input[Buffer[int]](count)
    tree: Buffer[int] = ppy.buffer[int](LIMIT)
    print(count_inversions(values, tree))


main()
