"""Counting inversions, judge style (Baekjoon 1517, bubble-sort swaps).

Input:  N on the first line, then N integers.
Output: how many pairs are out of order.
"""

import array
import time
from typing import Final

import ppy
from ppy import Buffer

LIMIT: Final[int] = 1000004


@ppy.opt(3)
def add(tree: Buffer[int], position: int, delta: int) -> int:
    index: int = position + 1
    while index < LIMIT:
        tree[index] += delta
        index += index & -index
    return index


@ppy.pure
@ppy.opt(3)
def prefix(tree: Buffer[int], position: int) -> int:
    total: int = 0
    index: int = position + 1
    while index > 0:
        total += tree[index]
        index -= index & -index
    return total


@ppy.opt(3)
def count_inversions(values: Buffer[int], tree: Buffer[int]) -> int:
    total: int = 0
    for i in range(len(values) - 1, -1, -1):
        total += prefix(tree, values[i] - 1)
        add(tree, values[i], 1)
    return total


def read_values() -> Buffer[int]:
    """The judge's input, or a generated stand-in when nothing is piped in."""
    try:
        count = ppy.input(int)
    except EOFError:
        return array.array("q", [(i * 7919) % 1000003 for i in range(500000)])
    return ppy.input(Buffer[int], count)


def main() -> None:
    started = time.perf_counter()
    values = read_values()
    read_ms = (time.perf_counter() - started) * 1000.0

    tree = array.array("q", [0] * LIMIT)
    started = time.perf_counter()
    answer: int = count_inversions(values, tree)
    solve_ms = (time.perf_counter() - started) * 1000.0

    print(answer)
    print(f"# n={len(values)} read {read_ms:.1f} ms   solve {solve_ms:.1f} ms")


main()
