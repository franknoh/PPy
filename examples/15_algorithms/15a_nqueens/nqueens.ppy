"""N-Queens: https://www.acmicpc.net/problem/9663

Input:  N on the first line.
Output: how many ways N queens can be placed without attacking each other.
"""
import ppy


@ppy.pure
def solve(full: int, columns: int, diagonal: int, antidiagonal: int) -> int:
    if columns == full:
        return 1
    total: int = 0
    available: int = full & ~(columns | diagonal | antidiagonal)
    while available != 0:
        bit: int = available & -available
        available -= bit
        total += solve(
            full,
            columns | bit,
            ((diagonal | bit) << 1) & full,
            (antidiagonal | bit) >> 1,
        )
    return total


def read_size() -> int:
    """The judge's input, or the stand-in this example uses on its own."""
    try:
        return ppy.input[int]()
    except EOFError:
        return 12


def main() -> None:
    n: int = read_size()
    print(solve((1 << n) - 1, 0, 0, 0))


main()
