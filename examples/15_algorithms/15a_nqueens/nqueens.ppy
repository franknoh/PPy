"""N-Queens, judge style (Baekjoon 9663).

Input:  N on the first line.
Output: how many ways N queens can be placed without attacking each other.
"""

import sys
import time

import ppy


@ppy.pure
@ppy.opt(3)
def solve(full: int, columns: int, diagonal: int, antidiagonal: int) -> int:
    if columns == full:
        return 1
    total: int = 0
    available: int = full & ~(columns | diagonal | antidiagonal)
    while available != 0:
        bit: int = available & -available
        available -= bit
        total += solve(
            full,
            columns | bit,
            ((diagonal | bit) << 1) & full,
            (antidiagonal | bit) >> 1,
        )
    return total


def read_size() -> int:
    """The judge's input, or the stand-in this example uses on its own."""
    text = sys.stdin.read()
    return int(text.split()[0]) if text.strip() else 12


def main() -> None:
    n: int = read_size()
    started = time.perf_counter()
    answer: int = solve((1 << n) - 1, 0, 0, 0)
    solve_ms = (time.perf_counter() - started) * 1000.0

    print(answer)
    print(f"# n={n} solve {solve_ms:.1f} ms")


main()
