"""Hand-written native C API: borrowed rows, explicit integers, and void exports."""

from ppy import i32, native


@native.export
def game_init() -> None:
    pass


@native.export
def process(ice: native.ptr[i32, 8]) -> None:
    for row in range(8):
        for col in range(8):
            ice[row, col] = ice[row, col] + row * 8 + col
