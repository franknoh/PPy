[MAIN]
ignored-modules = torch, jax, jax.numpy, numpy, pydantic, uvicorn, fastapi, fastapi.testclient, flax, flax.linen, optax, geometry, ppy, pandas, pyarrow, pyarrow.compute, scipy

[MESSAGES CONTROL]
enable = all
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    duplicate-code,
    too-few-public-methods,
    use-implicit-booleaness-not-comparison-to-zero,
    consider-using-enumerate,
    eval-used,
    wrong-import-position,
    unused-argument,
    # The suppression audit, which `enable = all` turns on: a local disable
    # would otherwise be a finding about itself, and there is no other way
    # for one example to exceed a limit every other example is held to --
    # `46_gpt2`'s region takes each of a transformer block's weights as a
    # parameter of its own, which is what a region is.
    locally-disabled,
    suppressed-message,
    useless-suppression,

[FORMAT]
max-line-length = 100

[DESIGN]
max-args = 8
max-positional-arguments = 8
max-locals = 28
