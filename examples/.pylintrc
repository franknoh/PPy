[MAIN]
ignored-modules = torch, jax, jax.numpy, numpy, pydantic, uvicorn, fastapi, fastapi.testclient, flax, flax.linen, optax, geometry, ppy, pandas, pyarrow, pyarrow.compute, scipy

[MESSAGES CONTROL]
enable = all
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    duplicate-code,
    too-few-public-methods,
    use-implicit-booleaness-not-comparison-to-zero,
    consider-using-enumerate,
    eval-used,
    wrong-import-position,
    unused-argument,

[FORMAT]
max-line-length = 100

[DESIGN]
max-args = 8
max-positional-arguments = 8
max-locals = 28
